# Copia este archivo como .env y llena los valores. El .env real NUNCA va a git.
PLN_DB_SERVER=agpcolombia.database.windows.net
PLN_DB_NAME=AGP_Ingenieria
PLN_DB_USER=DevIngenieria
PLN_DB_PASSWORD=
PLN_DB_DRIVER=ODBC Driver 18 for SQL Server

PLN_JWT_SECRET=
PLN_JWT_HORAS=12

PLN_AZURE_STORAGE_CONNECTION_STRING=
PLN_AZURE_STORAGE_CONTAINER=planner-adjuntos
PLN_ADJUNTO_MAX_MB=25

PLN_FRONTEND_URL=http://localhost:5190
PLN_CORS_ORIGENES=http://localhost:5190

# simulado = .eml en correos_simulados/ | graph = Microsoft Graph (requiere TI) | powerautomate = flujo de Power Automate
PLN_CORREO_MODO=simulado
PLN_CORREO_REMITENTE=planner@agpglass.com
PLN_GRAPH_TENANT_ID=
PLN_GRAPH_CLIENT_ID=
PLN_GRAPH_CLIENT_SECRET=
# URL del disparador HTTP del flujo de correos (secreta, no compartir)
PLN_POWER_AUTOMATE_URL=
